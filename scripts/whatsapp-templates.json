  {
    "name": "pv_feedback_kn_v3",
    "status": "APPROVED",
    "language": "kn",
    "category": "UTILITY",
    "parameter_format": "POSITIONAL",
    "components": [
      {
        "type": "HEADER",
        "format": "TEXT",
        "text": "ನಿಮ್ಮ ಭೇಟಿ ಹೇಗಿತ್ತು?"
      },
      {
        "type": "BODY",
        "text": "ನಮಸ್ಕಾರ *{{1}}*,\n\n*{{2}}* ಗೆ ಭೇಟಿ ನೀಡಿದ್ದಕ್ಕಾಗಿ ಧನ್ಯವಾದಗಳು. ನಿಮ್ಮ ಪ್ರಯಾಣ ಸುಖಕರವಾಗಿತ್ತು ಎಂದು ಆಶಿಸುತ್ತೇವೆ.\n\nಇಂದಿನ ನಿಮ್ಮ ಅನುಭವ ಹೇಗಿತ್ತು? ಒಂದು ನಿಮಿಷಕ್ಕಿಂತ ಕಡಿಮೆ ಸಮಯ ಸಾಕು — ಕೆಳಗೆ ಟ್ಯಾಪ್ ಮಾಡಿ ರೇಟಿಂಗ್ ನೀಡಿ.\n\nಪ್ರವೇಶ,\nಸೇವೆ ಒದಗಿಸುವವರು: *ಸರ್ವರ್‌ಪೇ ಆಪ್ ಸೊಲ್ಯೂಷನ್ಸ್.*",
        "example": {
          "body_text": [
            [
              "Shiva",
              "Mullaingiri"
            ]
          ]
        }
      },
      {
        "type": "FOOTER",
        "text": "ಪ್ರವೇಶ - ಪ್ರವಾಸೋದ್ಯಮ ಇಲಾಖೆ (ಕರ್ನಾಟಕ)"
      },
      {
        "type": "BUTTONS",
        "buttons": [
          {
            "type": "URL",
            "text": "ಪ್ರತಿಕ್ರಿಯೆಯನ್ನು ಒದಗಿಸಿ",
            "url": "https://pravesha.in/karnataka-tourism/entry-pass/verify/%7B%7B1%7D%7D{{1}}",
            "example": [
              "https://pravesha.in/karnataka-tourism/entry-pass/verify/WERT23423EEF"
            ]
          }
        ]
      }
    ],
    "id": "1823578822145822"
  },
